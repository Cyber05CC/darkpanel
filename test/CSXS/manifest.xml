<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" 
    ExtensionBundleId="com.motion.speedgraph" 
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Speed Graph Pro">

  <ExtensionList>
    <Extension Id="com.motion.speedgraph.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[17.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
        <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.motion.speedgraph.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/app.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--disable-web-security</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>

        <Lifecycle>
            <AutoVisible>true</AutoVisible>
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Speed Graph Pro</Menu>
          <Geometry>
            <Size>
              <Width>280</Width>
              <Height>500</Height>
            </Size>
            <MinSize>
              <Width>200</Width>
              <Height>400</Height>
            </MinSize>
            <MaxSize>
              <Width>600</Width>
              <Height>800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>